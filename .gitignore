__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
dist/
build/

# Every .env variant is ignored, with only the placeholder template tracked. A bare `.env`
# rule would miss .env.production and friends.
.env
.env.*
!.env.example

# Credential material that should never be committed even by accident.
*.pem
*.key
*.p12
*.pfx
secrets/

.pytest_cache/
.hypothesis/
.ruff_cache/
.coverage
htmlcov/

# Generated by the CI audit step from uv.lock.
requirements.audit.txt

.idea/
.vscode/
*.swp
.DS_Store

# Written into the clone on the server by scripts/deploy.sh: the flock target, and the tag to go
# back to. They are facts about one box rather than about the code, and a deploy that has just
# refused sends somebody to read `git status` in that directory — which is the worst moment to
# hand them two untracked files that are not the problem.
.deploy.lock
.deploy-previous-tag
