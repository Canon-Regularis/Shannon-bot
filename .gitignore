__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
dist/
build/

# Every .env variant is ignored, with only the placeholder template tracked. A bare `.env`
# rule would miss .env.production and friends.
.env
.env.*
!.env.example

# Credential material that should never be committed even by accident.
*.pem
*.key
*.p12
*.pfx
secrets/

.pytest_cache/
.hypothesis/
.ruff_cache/
.coverage
htmlcov/

# Generated by the CI audit step from uv.lock.
requirements.audit.txt

.idea/
.vscode/
*.swp
.DS_Store
