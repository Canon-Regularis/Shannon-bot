.git/
.gitignore

.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/

.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Tests are not run from the runtime image, and secrets must never reach the build context.
# Anything copied in stays in that layer even if a later step deletes it.
tests/
.env
.env.*
*.pem
*.key
*.p12
*.pfx
secrets/

docs/
.github/
CHANGELOG.md
requirements.md
requirements.audit.txt
docker-compose.yml
Dockerfile
.dockerignore

.idea/
.vscode/

# What `nix develop` brings and leaves. The image never uses Nix, and `.nix/` holds an environment
# per Python version, uv's cache and a live database, gigabytes the build would send as context.
flake.nix
flake.lock
.nix/
.direnv/
result
result-*
