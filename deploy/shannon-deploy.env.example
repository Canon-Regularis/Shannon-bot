# Copy to /etc/shannon-deploy.env, chmod 600. Every line here has a working default except the
# Discord webhook, so the shortest usable version of this file is the webhook alone.

# Where the stack lives. `.env` and compose.prod.yaml are read from here.
SHANNON_DEPLOY_DIR=/opt/shannon
SHANNON_DEPLOY_COMPOSE=compose.prod.yaml
SHANNON_DEPLOY_IMAGE=ghcr.io/canon-regularis/shannon-bot

# Where skopeo and docker find the GHCR credential. This is the file `docker login ghcr.io`
# wrote; nothing new is stored anywhere.
SHANNON_DEPLOY_AUTHFILE=/root/.docker/config.json

# How long to give the new container to report healthy before calling the deploy failed and
# rolling back. The image's own HEALTHCHECK takes 95s to declare a container unhealthy, so this
# has to be comfortably more than that.
SHANNON_DEPLOY_HEALTH_TIMEOUT=180

# Where a deploy announces itself. A Discord webhook URL for whichever channel you want told:
# Server Settings, Integrations, Webhooks, New Webhook, Copy Webhook URL. Leave it empty and the
# only record is `journalctl -u shannon-deploy`, which is a place nobody looks until they already
# suspect something.
SHANNON_DEPLOY_DISCORD_WEBHOOK=

# Touch this file to stop automatic deploys without disabling the timer, which is what you want
# while working on the box by hand. A failed deploy writes it too, and says why inside.
SHANNON_DEPLOY_HOLD_FILE=/opt/shannon/deploy.hold

# How old an unused shannon-bot image has to be before a successful deploy removes it. Thirty
# days keeps every rollback target you are realistically going to want; anything older can be
# pulled back from ghcr.io by its sha- tag.
SHANNON_DEPLOY_PRUNE_AFTER_HOURS=720
