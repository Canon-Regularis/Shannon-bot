# Five minutes. The check is one HTTPS manifest request that downloads no layers, so the cost of
# asking is nothing; what five minutes buys is the width of the window between a release being
# published and the bot running it. Persistent is off deliberately: a box that was down over a
# release should come up, run its check on the OnBootSec schedule below like any other, and not
# fire a missed timer into the middle of boot.

[Unit]
Description=Check for a new Shannon bot image

[Timer]
OnBootSec=3min
OnUnitActiveSec=5min
# So this does not knock on ghcr.io at exactly :00 and :05 with everyone else.
RandomizedDelaySec=90
AccuracySec=30s
Persistent=false
Unit=shannon-deploy.service

[Install]
WantedBy=timers.target
