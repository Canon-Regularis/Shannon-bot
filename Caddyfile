# The only thing on this host that faces the internet.
#
# Caddy asks Let's Encrypt for a certificate on first start and renews it on its own, which is
# the whole reason it is here rather than a port mapping: GitHub sends a private repository's
# issue titles and comment bodies in the request body, and a webhook secret proves who sent a
# payload rather than hiding it from anyone reading the wire.

{
	email {$ACME_EMAIL}
}

{$SHANNON_HOSTNAME} {
	# FastAPI serves these unconditionally and there is no middleware in front of them, so
	# without this the full API surface, its schemas and an interactive client are published to
	# anyone who asks. Nothing here needs them in production, and the endpoint they describe is
	# the one place an attacker would start.
	handle /docs* {
		respond 404
	}
	handle /redoc* {
		respond 404
	}
	handle /openapi.json {
		respond 404
	}

	# Answers whether the database is reachable, the worker is alive and the gateway is up, and
	# which commit is answering. Left reachable rather than blocked because a monitor with no
	# credentials is the ordinary way to watch a service.
	#
	# The commit is the one thing here that gives something away, and it is worth writing down
	# rather than leaving to be discovered. This repository is public, so the hash names a tree
	# anybody can read: it says which fixes this deployment has and, more to the point, which
	# ones it has not. That is accepted rather than overlooked. There is one route behind this
	# that does anything, it refuses every request without a valid HMAC, and knowing the commit
	# does not help anybody forge one. Take this field out if the calculation changes.
	handle /health {
		reverse_proxy app:8000
	}

	handle /webhooks/* {
		reverse_proxy app:8000
	}

	# Where GitHub sends somebody back after they have proved who they are, for `/unregister` and
	# `/verify`. Public and unsigned because it has to be: a browser arrives carrying a code, with
	# no credential of its own and nothing to sign with.
	#
	# What stands in for one is the `state` in the query string. It is 256 bits from
	# `secrets.token_urlsafe`, it is spent by a single UPDATE so two clicks on one link race in
	# Postgres rather than in Python, it expires in ten minutes, and the page echoes neither it nor
	# the code back. Guessing one is the whole attack and there is nothing here to guess it from.
	#
	# Left out when this file was written, which is not a small thing: the route existed, the
	# command handed out links to it, and every one of them landed on the catch-all below. So
	# `/unregister` could never finish, and the failure looked like a dead domain rather than like
	# a proxy rule. `tests/unit/test_the_proxy_forwards_every_route.py` is there so the next route
	# cannot go the same way.
	handle /oauth/* {
		reverse_proxy app:8000
	}

	# Anything else is not part of this service.
	handle {
		respond 404
	}

	log {
		output stdout
		format console
	}
}
