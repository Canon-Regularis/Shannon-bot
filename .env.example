# Copy to .env and fill in. .env is gitignored; never commit the filled-in file.

SHANNON_DATABASE_URL=postgresql+asyncpg://shannon:shannon@localhost:5433/shannon

# Read by docker compose to build the database and its URL. The defaults are throwaway local
# credentials. Set real ones here for anything that is not a laptop.
POSTGRES_USER=shannon
POSTGRES_PASSWORD=shannon
POSTGRES_DB=shannon

# Read by docker compose and by the Caddyfile on a server, not by the application, which ignores
# anything here it has no field for. compose.prod.yaml names both with `:?`, so a .env copied
# from this file without them refuses to bring the stack up at all rather than starting something
# that can never get a certificate. Left at example values because a laptop never reads them.
SHANNON_HOSTNAME=shannon.example.com
ACME_EMAIL=you@example.com

# Which image tag the server follows is deliberately not offered here. The deploy script strips
# and rewrites that line on every run, so any value written in this file is correct for at most
# one deploy and wrong after it, and the compose file falls back to `edge` for the window before
# the first one. See scripts/README.md.

SHANNON_DISCORD_TOKEN=your-discord-bot-token

# The GitHub App. It replaced a single personal access token that had to see every repository,
# which was untidy while everything was public and unusable once private repositories could be
# registered: /register is open to anybody holding the Admin role in any server this bot is in.
#
# The client id is both the JWT issuer and the OAuth client id, so there is one identifier here
# rather than two that have to agree. The private key is the .pem GitHub issued, on one line with
# its newlines written as a backslash and an n.
SHANNON_GITHUB_APP_CLIENT_ID=
SHANNON_GITHUB_APP_PRIVATE_KEY=your-github-app-private-key-pem
SHANNON_GITHUB_APP_CLIENT_SECRET=your-github-app-client-secret
SHANNON_GITHUB_APP_WEBHOOK_SECRET=your-github-app-webhook-secret

# Where GitHub sends somebody back after they prove who they are for /unregister. Must match the
# callback URL set on the App. Empty makes /unregister refuse rather than hand out a broken link.
SHANNON_PUBLIC_BASE_URL=
SHANNON_GITHUB_OAUTH_URL=https://github.com

# Whether a link nobody proved may write to GitHub. Leave it off until everybody has run
# /verify, or /assign refuses for the whole server at once.
SHANNON_REQUIRE_PROVED_LINKS=false

# Kept for the window in which a repository webhook configured by hand is still live alongside the
# App's own. Delete that webhook once the App is installed: until you do, GitHub sends everything
# twice under different delivery ids, nothing here can tell, and every commit line posts twice.
SHANNON_GITHUB_WEBHOOK_SECRET=your-webhook-shared-secret

# The one credential the App cannot replace. GitHub publishes no App permission for a USER-owned
# Projects v2 board, so the board mirror needs a fine-grained token with user Projects:
# Read-only. Leave it empty unless SHANNON_GITHUB_PROJECT_NUMBER is set.
SHANNON_GITHUB_PROJECT_TOKEN=

# Comma separated Discord role names. A guild Administrator always passes every check.
SHANNON_ROLE_ADMIN=Admin
SHANNON_ROLE_PROJECT_MANAGER=Project Manager
SHANNON_ROLE_REVIEWER=Reviewer
SHANNON_ROLE_DEVELOPER=Developer

SHANNON_API_HOST=0.0.0.0
SHANNON_API_PORT=8000
SHANNON_LOG_LEVEL=INFO

# Where the REST calls go. Only worth changing for GitHub Enterprise, which serves the same API
# under a host of its own.
SHANNON_GITHUB_API_URL=https://api.github.com
SHANNON_GITHUB_TIMEOUT_SECONDS=10

# The project board to mirror, by the number at the end of its URL. Zero, the default, means the
# board is not read at all, which is why this is here rather than only in the README: nothing
# about the feature is visible until somebody sets it.
SHANNON_GITHUB_PROJECT_NUMBER=0
# Who owns that board, if it is not the account owning the registered repository. Empty means it
# is. The number above is a sequence GitHub keeps per account, so the wrong owner is not a board
# that is missing, it is a different board that may well exist and be somebody else's.
SHANNON_GITHUB_PROJECT_OWNER=
# GitHub sends no webhook for a personal account's board, so it is polled. This is how often.
SHANNON_PROJECT_POLL_SECONDS=60
# Whether dragging a card may change an item's status. Off: nothing GitHub sends with a board
# says who moved a card, so this would be a way past the Project Manager role.
SHANNON_BOARD_MAY_SET_STATUS=false

# The endpoint writes a delivery down and answers; these govern the worker that acts on it.
# Every one has a working default, so leave them alone unless something says otherwise.
SHANNON_WORKER_POLL_SECONDS=2
SHANNON_WORKER_BATCH_SIZE=10
SHANNON_WORKER_MAX_ATTEMPTS=16
SHANNON_WORKER_MAX_BACKOFF_SECONDS=900
SHANNON_WORKER_LEASE_SECONDS=900
SHANNON_WORKER_DELIVERY_TIMEOUT_SECONDS=60
SHANNON_WORKER_SHUTDOWN_GRACE_SECONDS=5
# Bodies hold titles and comment text from private repositories, so they are dropped after this.
SHANNON_DELIVERY_RETENTION_DAYS=7

# Publishing a Discord conversation to an item's GitHub comments, with /log_conversation.
#
# Turning this on asks Discord for the message content intent, which is privileged: tick the box
# under Bot in the Developer Portal FIRST, then set this. The other order does not start: a process
# refused a privileged intent it asked for stops, taking the webhook mirror, the delivery worker
# and the board poller with it. An application in over a hundred servers has to apply to Discord
# for the intent rather than just ticking it.
SHANNON_CAPTURE_DISCORD_MESSAGES=false
# How long a logged thread goes quiet before what was said in it is published, and how often the
# publisher looks. Both have working defaults.
SHANNON_CONVERSATION_QUIET_SECONDS=60
SHANNON_CONVERSATION_FLUSH_TICK_SECONDS=5

# Read straight from the environment by the integration test tier, not by the application.
# Leave unset to skip those tests.
SHANNON_TEST_DATABASE_URL=
