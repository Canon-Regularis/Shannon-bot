# Copy to .env and fill in. .env is gitignored; never commit the filled-in file.

SHANNON_DATABASE_URL=postgresql+asyncpg://shannon:shannon@localhost:5433/shannon

# Read by docker compose to build the database and its URL. The defaults are throwaway local
# credentials. Set real ones here for anything that is not a laptop.
POSTGRES_USER=shannon
POSTGRES_PASSWORD=shannon
POSTGRES_DB=shannon

# Read by docker compose and by the Caddyfile on a server, not by the application, which ignores
# anything here it has no field for. compose.prod.yaml names both with `:?`, so a .env copied
# from this file without them refuses to bring the stack up at all rather than starting something
# that can never get a certificate. Left at example values because a laptop never reads them.
SHANNON_HOSTNAME=shannon.example.com
ACME_EMAIL=you@example.com

# Which image tag the server follows is deliberately not offered here. The deploy script strips
# and rewrites that line on every run, so any value written in this file is correct for at most
# one deploy and wrong after it, and the compose file falls back to `edge` for the window before
# the first one. See scripts/README.md.

SHANNON_DISCORD_TOKEN=your-discord-bot-token

# The GitHub App. It replaced a single personal access token that had to see every repository,
# which was untidy while everything was public and unusable once private repositories could be
# registered: /register is open to anybody holding the Admin role in any server this bot is in.
#
# The client id is both the JWT issuer and the OAuth client id, so there is one identifier here
# rather than two that have to agree. The private key is the .pem GitHub issued, on one line with
# its newlines written as a backslash and an n.
SHANNON_GITHUB_APP_CLIENT_ID=
SHANNON_GITHUB_APP_PRIVATE_KEY=your-github-app-private-key-pem
SHANNON_GITHUB_APP_CLIENT_SECRET=your-github-app-client-secret
SHANNON_GITHUB_APP_WEBHOOK_SECRET=your-github-app-webhook-secret

# Where Discord and GitHub send somebody back while they follow a one-time link. Must match the
# redirects set on the App, the board OAuth App and the Discord application below. Empty makes
# every command that hands out a link refuse rather than hand out a broken one.
SHANNON_PUBLIC_BASE_URL=
SHANNON_GITHUB_OAUTH_URL=https://github.com

# The bot's own Discord application - the one SHANNON_DISCORD_TOKEN belongs to - as a sign-in.
# Every one-time link (/link, /register, /unregister, /board link, /board authorise) opens on this
# bot and asks Discord who is holding the browser before GitHub is asked anything, so a link only
# works for the member who ran the command. Asked for `identify` and nothing else.
#
# Developer Portal -> your application -> OAuth2:
#
#   Redirects        add <SHANNON_PUBLIC_BASE_URL>/oauth/discord/callback   (exactly)
#   Client ID        copy into SHANNON_DISCORD_CLIENT_ID
#   Client Secret    Reset Secret and copy into SHANNON_DISCORD_CLIENT_SECRET; the bot token is
#                    a different credential and is not touched
#   Public Client    off - the secret is what makes the exchange this bot's own
#
# Unset means every link is refused, and the bot says so at startup. Deliberately: a link that
# skipped this step would be one anybody it was forwarded to could finish as whoever ran it.
SHANNON_DISCORD_CLIENT_ID=
SHANNON_DISCORD_CLIENT_SECRET=

# Whether a link nobody proved may write to GitHub. Leave it off until everybody has run
# /link, or /assign refuses for the whole server at once.
SHANNON_REQUIRE_PROVED_LINKS=false

# Kept for the window in which a repository webhook configured by hand is still live alongside the
# App's own. Delete that webhook once the App is installed: until you do, GitHub sends everything
# twice under different delivery ids, nothing here can tell, and every commit line posts twice.
SHANNON_GITHUB_WEBHOOK_SECRET=your-webhook-shared-secret

# ----------------------------------------------------------------------------------------------
# Project boards: the SECOND registered application
# ----------------------------------------------------------------------------------------------
# A project board cannot be reached through the App above, and this is not a preference. GitHub
# publishes no App permission for a USER-owned board - its Projects permission exists at
# organisation level only - and granting an installed App an organisation permission suspends its
# event delivery until an admin accepts it, which would stop every webhook in every registered
# repository. OAuth scopes have neither problem, and `project` covers user and organisation
# projects alike.
#
# So boards go through a CLASSIC OAUTH APP, registered separately. It touches nothing about the
# App above and needs no reinstall.
#
# Register it at Settings -> Developer settings -> OAuth Apps -> New OAuth App (NOT GitHub Apps):
#
#   Redirect URI                 <SHANNON_PUBLIC_BASE_URL>/oauth/github/callback   (exactly)
#   Allow wildcard matching      off - a code must only ever reach the one path this bot uses
#   Enable Device Flow           off - the web redirect flow is the one implemented
#   Expire user access tokens    off - see the key below
#
# "Expire user access tokens" must stay OFF. Turned on, GitHub issues an eight-hour token and a
# six-month refresh token, and a board would stop being read eight hours after it was linked;
# nobody is at a keyboard during a poll to consent again. It is also the worse trade on security,
# because a refresh token outlives every access token it mints, so keeping both roughly doubles
# what a stolen database is worth.
#
# One authorisation per PERSON, not one per deployment. Whoever links a board authorises this
# themselves - /board link hands out one link, and following it both authorises and links - and
# that authorisation is what their board is read under. A card moved from Discord is moved as
# whoever moved it, with what they granted through /board link or /board authorise. What this
# replaced was one classic token belonging to one human account, shared by every server, with the
# `project` scope across every project that account
# could see - so one leak was write access to all of them, and the board's history named the
# token's owner whoever had actually asked.
SHANNON_GITHUB_BOARD_CLIENT_ID=
SHANNON_GITHUB_BOARD_CLIENT_SECRET=your-board-oauth-app-client-secret

# The key those authorisations are encrypted with, and the only encryption in this schema.
#
# Everything else this bot stores about somebody is a fact ABOUT them - a login, an account id, a
# preference. A board authorisation is a thing that ACTS as them, so it is encrypted at rest with
# a key that lives here and never in the database. That is what makes a stolen copy of the table
# worth nothing on its own.
#
# Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#
# A comma-separated list, NEWEST FIRST. The cipher encrypts with the first key and decrypts with
# any of them, so rotating is "put the new key in front, deploy, drop the old one next deploy"
# rather than every person who linked a board doing it again.
#
# Unset or unreadable means boards are off, said once and loudly. Deliberately not a setting that
# refuses to start: a lock added over a working system must not become the reason the system
# stops, and taking webhooks and deliveries down over a board setting would be the worse failure.
SHANNON_BOARD_CREDENTIAL_KEY=

# Comma separated Discord role names. A guild Administrator always passes every check.
SHANNON_ROLE_ADMIN=Admin
SHANNON_ROLE_PROJECT_MANAGER=Project Manager
SHANNON_ROLE_REVIEWER=Reviewer
SHANNON_ROLE_DEVELOPER=Developer

SHANNON_API_HOST=0.0.0.0
SHANNON_API_PORT=8000
SHANNON_LOG_LEVEL=INFO

# Where the REST calls go. Only worth changing for GitHub Enterprise, which serves the same API
# under a host of its own.
SHANNON_GITHUB_API_URL=https://api.github.com
SHANNON_GITHUB_TIMEOUT_SECONDS=10

# Whether THIS process reads project boards at all. Run the poller in ONE replica: nothing elects
# a leader, and two pollers racing on one card can each put its row back and undo the other's
# finished move, permanently. This is the switch that says which replica. It used to be a board
# number in this file, set to zero everywhere else - which stopped working the moment a board could
# be linked by a command, because a second replica would then start polling with no env change to
# notice. There is no setting naming a board any more: run /board link in the server instead.
SHANNON_POLL_BOARDS=true
# GitHub sends no webhook for a personal account's board - the projects_v2 events are an
# ORGANISATION scope - so it is polled. This is how often. Two seconds is affordable because
# the read is conditional: GitHub answers an unchanged board with 304, which carries no body
# and spends no rate-limit budget, so a quiet board costs one request and nothing else.
SHANNON_PROJECT_POLL_SECONDS=2
# Whether dragging a card may change an item's status. Off: nothing GitHub sends with a board
# says who moved a card, so this would be a way past the Project Manager role.
SHANNON_BOARD_MAY_SET_STATUS=false
# The other direction: whether a status set in Discord drags the card on the board.
# ON, because a server that ran /board link asked for its board to be the truth, and a
# /status that writes the label and leaves the card where it was does half the job
# without saying so (issue #179).
#
# The card is written AS whoever moved it, with the authorisation they granted through
# /board authorise or /board link - the `project` scope, read and write, which the
# sign-in checks GitHub actually granted. Somebody who has granted nothing is refused by
# /status and /priority before anything is written, because that is the one board
# failure they can fix themselves. An organisation's board also needs the organisation to
# approve the board OAuth App, which is an access restriction rather than a scope.
#
# Turning it off stops the card being written and NOTHING else. The board is still read,
# so a move its column order forbids is still refused - that rule costs a read, not a
# write, and it used to go off with this flag, which was the other half of #179.
SHANNON_BOARD_MAY_MOVE_CARDS=true

# The endpoint writes a delivery down and answers; these govern the worker that acts on it.
# Every one has a working default, so leave them alone unless something says otherwise.
SHANNON_WORKER_POLL_SECONDS=2
SHANNON_WORKER_BATCH_SIZE=10
SHANNON_WORKER_MAX_ATTEMPTS=16
SHANNON_WORKER_MAX_BACKOFF_SECONDS=900
SHANNON_WORKER_LEASE_SECONDS=900
SHANNON_WORKER_DELIVERY_TIMEOUT_SECONDS=60
SHANNON_WORKER_SHUTDOWN_GRACE_SECONDS=5
# Bodies hold titles and comment text from private repositories, so they are dropped after this.
SHANNON_DELIVERY_RETENTION_DAYS=7

# Publishing a Discord conversation to an item's GitHub comments, with /log_conversation.
#
# Turning this on asks Discord for the message content intent, which is privileged: tick the box
# under Bot in the Developer Portal FIRST, then set this. The other order does not start: a process
# refused a privileged intent it asked for stops, taking the webhook mirror, the delivery worker
# and the board poller with it. An application in over a hundred servers has to apply to Discord
# for the intent rather than just ticking it.
SHANNON_CAPTURE_DISCORD_MESSAGES=false
# How long a logged thread goes quiet before what was said in it is published, and how often the
# publisher looks. Both have working defaults.
SHANNON_CONVERSATION_QUIET_SECONDS=60
SHANNON_CONVERSATION_FLUSH_TICK_SECONDS=5

# Read straight from the environment by the integration test tier, not by the application.
# Leave unset to skip those tests.
SHANNON_TEST_DATABASE_URL=
